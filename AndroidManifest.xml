<?xml version="1.0" encoding="utf-8"?>
<!-- A one-toggle utility: keep the screen on system-wide. Two mechanisms,
     chosen at start: an overlay window carrying FLAG_KEEP_SCREEN_ON (the
     window manager keeps the screen on for any visible window; there is no
     wake lock for PowerKeeper to release), or — until the user grants the
     overlay permission — a SCREEN_BRIGHT_WAKE_LOCK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.local.keepon" android:versionCode="6" android:versionName="1.5">
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Special app access: the system settings page grants it after install;
       with it the app sets the screen-off timeout, the ROM-proof mechanism. -->
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Android 14+ requires a declared type for every foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The "允许后台运行" button fires the exemption dialog; without this
       permission the intent is a no-op. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name=".KeepOnService" android:exported="false"
      android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keep the screen on at the user's explicit request; the toggle lives in the app." />
    </service>
  </application>
</manifest>
